ANTHROPIC_API_KEY=your_api_key_here
PORT=4009
# 교사 인증 코드 (6자 이상 필수, 비워 두면 서버가 시작되지 않는다). 예시 값을 그대로 쓰지 말 것
TEACHER_PIN=
# 동시 참여 팀 상한. 인프라 한계가 아니라 운영상의 안전장치다.
# 실측상 32팀까지 안정적으로 검증됨. 더 늘려도 무방하지만 AI 동시 호출량도 함께 늘어난다.
# 정원을 넘긴 학생은 조용히 빠지지 않고 "정원 초과" 안내와 함께 관람 모드로 들어간다.
MAX_TEAMS=40
# 평가 검증 토큰·생성 코드 서명(HMAC) 키 — 필수. 비워 두면 서버가 시작되지 않는다.
# 랜덤 32자 hex 이상 권장. TEACHER_PIN과 반드시 분리할 것
# 생성 예: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
EVALUATION_SECRET=
# CORS 허용 도메인 (쉼표 구분, 미설정 시 기본값 사용)
# 사설망(192.168.x.x / 10.x.x.x / 172.16~31.x.x)과 localhost는 설정과 무관하게 항상 허용됩니다
# ALLOWED_ORIGINS=https://vpython-prompt-challenge.fly.dev,http://localhost:4008,http://localhost:4009
# 교사 연수 입장 코드 — 운영 TEACHER_PIN과 별도. 설정하면 /training 에서 이 코드만으로 교사 화면에 들어간다.
# 연수 입장으로 들어온 교사는 API 키 설정·교체를 할 수 없고, 이미 사용 중인 수업코드로 수업을 만들 수 없다.
# 연수 토큰은 자기가 만든 수업에만 접근한다(같은 토큰이면 같은 수업코드로 이어가기 가능).
# 비워 두면 연수 입장이 닫히고, 재시작할 때 남아 있던 연수 토큰도 무효화된다.
TRAINING_CODE=
# 인증 실패 제한 — IP당 1분에 이 횟수만큼 실패하면 1분간 429 (기본 10). PIN과 연수 코드는 따로 센다.
# AUTH_FAIL_LIMIT=10
